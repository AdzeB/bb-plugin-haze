{
  "name": "bb-plugin-haze",
  "version": "0.6.1",
  "description": "MonoCode-style conversation background and live full-window backdrops (Cloud Drift) for BB.",
  "author": "AdzeB (https://github.com/AdzeB)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdzeB/bb-plugin-haze.git"
  },
  "homepage": "https://github.com/AdzeB/bb-plugin-haze#readme",
  "bugs": {
    "url": "https://github.com/AdzeB/bb-plugin-haze/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "background",
    "wallpaper",
    "theme",
    "glass",
    "dither",
    "halftone",
    "ascii",
    "backdrop",
    "animated"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
